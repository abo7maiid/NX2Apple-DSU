diff --git a/dm/host/pad_dsu_apple.h b/dm/host/pad_dsu_apple.h
new file mode 100644
index 0000000..8073f25
--- /dev/null
+++ b/dm/host/pad_dsu_apple.h
@@ -0,0 +1,38 @@
+// Cemuhook UDP (DSU Controller, protocol v1001, default port 26760) client transport, shared by the Mac and iOS front ends
+// (DmGamepad.m, controllers_mac.m), analogous to pad_switch2_apple.h. dsu_proto.h defines the wire protocol and coordinate mapping.
+//
+// Configuration (via environment or Documents/env.txt):
+//   DM_DSU=1 or DM_DSU=<server_ip[:port]>   Enables the DSU UDP client (default port 26760). When DM_DSU=1, the client binds to
+//                                           0.0.0.0:26760 to receive pushed DSU packets and also subscribes to 127.0.0.1:26760.
+//                                           When DM_DSU=<ip[:port]>, it binds an ephemeral/local UDP socket and sends 0x100002
+//                                           subscription requests every 2 seconds to that server.
+//   DM_DSU_PORT=<port>                      Overrides the UDP port (default 26760).
+//   DM_DSU_MAP=a,b,c,d,e,f                  Signed 1..6 channel permutation for DSU accelerometer and gyro axes.
+//   DM_DSU_VERBOSE=1                        Logs the first packet of each second per active slot.
+#pragma once
+#include "dsu_proto.h"
+
+typedef struct dsu_pad {
+    int slot;               // DSU slot 0..3
+    int active;             // 1 while connected and receiving reports
+    dsu_report r;
+    dsu_clock clk;
+    uint64_t last_rx_ns;
+    char name[48];
+} dsu_pad;
+
+// Callbacks invoked on the main queue, matching dm_switch2_front in pad_switch2_apple.h.
+typedef struct {
+    int (*attach)(dsu_pad *p);    // a new DSU slot became active: assign a player slot (1: kept, 0: all players taken)
+    void (*detach)(dsu_pad *p);   // a DSU slot disconnected or timed out
+    void (*read)(dsu_pad *p);     // the DSU pad's buttons/sticks updated
+    int (*player)(dsu_pad *p);    // 0-based player index, -1 when waiting for press-to-join
+    int (*blocked)(void);         // non-zero while focus is lost or the quit/controller prompt is open
+} dm_dsu_front;
+
+int dm_dsu_start(const dm_dsu_front *front);   // 1: started; 0: off (DM_DSU=0)
+void dm_dsu_teardown(void);                    // closes socket, stops timers and cleans up slots; safe across shell restarts
+void dm_dsu_active(int on);                    // focus lost (0): clears motion; focus restored (1): resumes
+dsu_pad *dm_dsu_pads(void);                    // array of DSU_SLOTS pads
+int dm_dsu_any_active(void);                   // 1 if at least one DSU slot is currently connected
+void dm_dsu_quit_buttons(int *home, int *a, int *b);   // Home / A / B state across active DSU slots for the quit prompt
diff --git a/dm/host/pad_dsu_apple.m b/dm/host/pad_dsu_apple.m
new file mode 100644
index 0000000..d14addb
--- /dev/null
+++ b/dm/host/pad_dsu_apple.m
@@ -0,0 +1,318 @@
+// Cemuhook UDP (DSU Controller, port 26760) client transport for iOS and macOS.
+// Uses Grand Central Dispatch (dispatch_source_t) on the main queue so all controller callbacks run on the main thread
+// alongside GameController and Switch 2 BLE callbacks.
+#import "pad_dsu_apple.h"
+#import <Foundation/Foundation.h>
+#include "dm.h"
+#include <arpa/inet.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <netdb.h>
+#include <netinet/in.h>
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#define DSU_TIMEOUT_NS 2500000000ull   // 2.5 seconds without a packet disconnects the slot
+
+static dm_dsu_front g_front;
+static dsu_pad g_pads[DSU_SLOTS];
+static int g_sock = -1;
+static dispatch_source_t g_read_src;
+static dispatch_source_t g_keepalive_timer;
+static struct sockaddr_in g_server_addr;
+static int g_has_server;
+static uint32_t g_client_id;
+static int g_active = 1, g_verbose, g_map_set;
+static int8_t g_map[6];
+static uint64_t g_last_log_ns[DSU_SLOTS];
+static _Atomic uint64_t g_dsu_gen __attribute__((section("__DATA,__dm_keep")));
+
+dsu_pad *dm_dsu_pads(void) { return g_pads; }
+
+int dm_dsu_any_active(void) {
+    for (int i = 0; i < DSU_SLOTS; i++) if (g_pads[i].active) return 1;
+    return 0;
+}
+
+void dm_dsu_quit_buttons(int *home, int *a, int *b) {
+    for (int i = 0; i < DSU_SLOTS; i++) {
+        if (!g_pads[i].active) continue;
+        if (dsu_home(&g_pads[i].r)) *home = 1;
+        dsu_ab(&g_pads[i].r, a, b);
+    }
+}
+
+static int dsu_player(dsu_pad *p) { return p && g_front.player ? g_front.player(p) : -1; }
+static int dsu_blocked(void) { return !g_active || (g_front.blocked && g_front.blocked()); }
+
+static void dsu_send_subscribe(void) {
+    if (g_sock < 0 || !g_has_server) return;
+    uint8_t req[32];
+    size_t n = dsu_make_data_req(req, g_client_id, 0, 0);
+    (void)sendto(g_sock, req, n, 0, (const struct sockaddr *)&g_server_addr, sizeof g_server_addr);
+    for (uint8_t s = 0; s < DSU_SLOTS; s++) {
+        n = dsu_make_data_req(req, g_client_id, 1, s);
+        (void)sendto(g_sock, req, n, 0, (const struct sockaddr *)&g_server_addr, sizeof g_server_addr);
+    }
+}
+
+static void dsu_slot_disconnect(dsu_pad *p, const char *reason) {
+    if (!p->active) return;
+    int pl = dsu_player(p);
+    if (pl >= 0) dm_motion_clear_hid(pl);
+    p->active = 0;
+    memset(&p->r, 0, sizeof p->r);
+    memset(&p->clk, 0, sizeof p->clk);
+    LOG("[dsu] %s disconnected (%s)", p->name, reason);
+    if (g_front.detach) g_front.detach(p);
+}
+
+static void dsu_check_timeouts(void) {
+    uint64_t now = now_ns();
+    for (int i = 0; i < DSU_SLOTS; i++) {
+        dsu_pad *p = &g_pads[i];
+        if (p->active && now > p->last_rx_ns && now - p->last_rx_ns > DSU_TIMEOUT_NS) {
+            dsu_slot_disconnect(p, "timed out");
+        }
+    }
+}
+
+static void dsu_handle_packet(const uint8_t *buf, size_t len, const struct sockaddr_in *from) {
+    dsu_report r;
+    if (!dsu_report_parse(buf, len, &r)) return;
+    dsu_pad *p = &g_pads[r.slot];
+    uint64_t now = now_ns();
+
+    // Learn the peer address if we started in passive/listen mode and received a packet
+    if (!g_has_server && from && from->sin_family == AF_INET) {
+        g_server_addr = *from;
+        g_has_server = 1;
+    }
+
+    if (!r.connected) {
+        if (p->active) dsu_slot_disconnect(p, "server reported disconnected");
+        return;
+    }
+
+    int newly_attached = 0;
+    if (!p->active) {
+        p->slot = r.slot;
+        snprintf(p->name, sizeof p->name, "DSU Controller %u", (unsigned)(r.slot + 1));
+        p->active = 1;
+        p->r = r;
+        p->last_rx_ns = now;
+        if (g_front.attach && !g_front.attach(p)) {
+            p->active = 0;
+            return;
+        }
+        newly_attached = 1;
+        int pl = dsu_player(p);
+        if (pl >= 0) LOG("[dsu] %s connected: player %d", p->name, pl + 1);
+        else LOG("[dsu] %s connected: press a button to play", p->name);
+    }
+
+    p->r = r;
+    p->last_rx_ns = now;
+
+    if (g_verbose && now - g_last_log_ns[r.slot] >= 1000000000ull) {
+        g_last_log_ns[r.slot] = now;
+        LOG("[dsu] slot %u pkt %u: b1=0x%02x b2=0x%02x sticks=(%u,%u %u,%u) acc=(%+.2f,%+.2f,%+.2f) gyro=(%+.1f,%+.1f,%+.1f)",
+            r.slot, r.packet_num, r.b1, r.b2, r.lx, r.ly, r.rx, r.ry,
+            r.raw_motion[0], r.raw_motion[1], r.raw_motion[2],
+            r.raw_motion[3], r.raw_motion[4], r.raw_motion[5]);
+    }
+
+    if (g_front.read) g_front.read(p);
+
+    int pl = dsu_player(p);
+    if (pl >= 0 && !dsu_blocked()) {
+        float acc[3], rot[3];
+        if (dsu_motion_to_switch(&r, g_map_set ? g_map : dsu_map_default, acc, rot)) {
+            uint64_t sample_ns = dsu_clock_sample(&p->clk, r.motion_ts_us, now);
+            dm_motion_set_hid(pl, acc, rot, sample_ns);
+        } else if (newly_attached) {
+            dm_motion_clear_hid(pl);
+        }
+    }
+}
+
+static void dsu_read_ready(void) {
+    if (g_sock < 0) return;
+    uint8_t buf[512];
+    struct sockaddr_in from;
+    for (int iter = 0; iter < 64; iter++) {
+        socklen_t flen = sizeof from;
+        memset(&from, 0, sizeof from);
+        ssize_t n = recvfrom(g_sock, buf, sizeof buf, 0, (struct sockaddr *)&from, &flen);
+        if (n <= 0) break;
+        dsu_handle_packet(buf, (size_t)n, &from);
+    }
+}
+
+void dm_dsu_active(int on) {
+    g_active = on;
+    if (!on) {
+        for (int i = 0; i < DSU_SLOTS; i++) {
+            if (g_pads[i].active) {
+                int pl = dsu_player(&g_pads[i]);
+                if (pl >= 0) dm_motion_clear_hid(pl);
+            }
+        }
+    }
+}
+
+static void dsu_teardown_on_main(void) {
+    if (g_keepalive_timer) {
+        dispatch_source_cancel(g_keepalive_timer);
+        g_keepalive_timer = nil;
+    }
+    if (g_read_src) {
+        dispatch_source_cancel(g_read_src);
+        g_read_src = nil;
+    } else if (g_sock >= 0) {
+        close(g_sock);
+        g_sock = -1;
+    }
+    for (int i = 0; i < DSU_SLOTS; i++) {
+        if (g_pads[i].active) {
+            int pl = dsu_player(&g_pads[i]);
+            if (pl >= 0) dm_motion_clear_hid(pl);
+            g_pads[i].active = 0;
+            if (g_front.detach) g_front.detach(&g_pads[i]);
+        }
+        memset(&g_pads[i], 0, sizeof g_pads[i]);
+    }
+    g_has_server = 0;
+    memset(&g_front, 0, sizeof g_front);
+}
+
+void dm_dsu_teardown(void) {
+    atomic_fetch_add(&g_dsu_gen, 1);
+    if ([NSThread isMainThread]) {
+        dsu_teardown_on_main();
+        return;
+    }
+    if (g_read_src || g_keepalive_timer || g_sock >= 0) {
+        dispatch_sync(dispatch_get_main_queue(), ^{ dsu_teardown_on_main(); });
+    }
+}
+
+static int parse_dsu_endpoint(const char *spec, const char *port_env, char host_out[128], uint16_t *port_out, int *passive_bind) {
+    *port_out = DSU_DEFAULT_PORT;
+    *passive_bind = 0;
+    host_out[0] = '\0';
+    if (port_env && atoi(port_env) > 0 && atoi(port_env) <= 65535) {
+        *port_out = (uint16_t)atoi(port_env);
+    }
+    if (spec && (!strcmp(spec, "0") || !strcasecmp(spec, "off"))) return 0;
+    if (!spec || !*spec || !strcmp(spec, "1") || !strcasecmp(spec, "on") || !strcasecmp(spec, "auto")) {
+        strlcpy(host_out, "127.0.0.1", 128);
+        *passive_bind = 1;
+        return 1;
+    }
+    const char *colon = strrchr(spec, ':');
+    if (colon && colon != spec) {
+        size_t hlen = (size_t)(colon - spec);
+        if (hlen >= 128) hlen = 127;
+        memcpy(host_out, spec, hlen);
+        host_out[hlen] = '\0';
+        int p = atoi(colon + 1);
+        if (p > 0 && p <= 65535) *port_out = (uint16_t)p;
+    } else {
+        strlcpy(host_out, spec, 128);
+    }
+    return 1;
+}
+
+int dm_dsu_start(const dm_dsu_front *front) {
+    const char *e = getenv("DM_DSU");
+    const char *pe = getenv("DM_DSU_PORT");
+    char host[128];
+    uint16_t port = DSU_DEFAULT_PORT;
+    int passive_bind = 0;
+    if (!parse_dsu_endpoint(e, pe, host, &port, &passive_bind)) return 0;
+
+    dm_dsu_teardown();
+    uint64_t gen = atomic_fetch_add(&g_dsu_gen, 1) + 1;
+    g_front = *front;
+    g_active = 1;
+    g_client_id = arc4random();
+    const char *ve = getenv("DM_DSU_VERBOSE");
+    g_verbose = ve && atoi(ve);
+    const char *me = getenv("DM_DSU_MAP");
+    g_map_set = 0;
+    if (me && *me && !(g_map_set = dsu_map_parse(me, g_map))) {
+        LOG("[dsu] DM_DSU_MAP='%s' is not six signed numbers in 1..6: using default map", me);
+    }
+
+    int fd = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    if (fd < 0) {
+        LOG("[RED] [dsu] socket() failed: %s", strerror(errno));
+        return 0;
+    }
+    int flags = fcntl(fd, F_GETFL, 0);
+    if (flags >= 0) (void)fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+    int reuse = 1;
+    (void)setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &reuse, sizeof reuse);
+#ifdef SO_REUSEPORT
+    (void)setsockopt(fd, SOL_SOCKET, SO_REUSEPORT, &reuse, sizeof reuse);
+#endif
+
+    struct sockaddr_in bind_addr;
+    memset(&bind_addr, 0, sizeof bind_addr);
+    bind_addr.sin_family = AF_INET;
+    bind_addr.sin_addr.s_addr = htonl(INADDR_ANY);
+    // In passive/auto mode (DM_DSU=1), try binding port 26760 directly so a client-pushing DSU app can send straight to us;
+    // if port 26760 is already bound by a local DSU server on the same host, fall back to an ephemeral port and poll it.
+    bind_addr.sin_port = htons(passive_bind ? port : 0);
+    if (bind(fd, (const struct sockaddr *)&bind_addr, sizeof bind_addr) < 0 && passive_bind) {
+        bind_addr.sin_port = htons(0);
+        (void)bind(fd, (const struct sockaddr *)&bind_addr, sizeof bind_addr);
+    }
+
+    memset(&g_server_addr, 0, sizeof g_server_addr);
+    g_server_addr.sin_family = AF_INET;
+    g_server_addr.sin_port = htons(port);
+    if (inet_pton(AF_INET, host, &g_server_addr.sin_addr) == 1) {
+        g_has_server = 1;
+    } else {
+        struct addrinfo hints, *res = NULL;
+        memset(&hints, 0, sizeof hints);
+        hints.ai_family = AF_INET;
+        hints.ai_socktype = SOCK_DGRAM;
+        if (getaddrinfo(host, NULL, &hints, &res) == 0 && res && res->ai_addrlen >= sizeof(struct sockaddr_in)) {
+            g_server_addr.sin_addr = ((const struct sockaddr_in *)res->ai_addr)->sin_addr;
+            g_has_server = 1;
+        }
+        if (res) freeaddrinfo(res);
+    }
+
+    g_sock = fd;
+    g_read_src = dispatch_source_create(DISPATCH_SOURCE_TYPE_READ, (uintptr_t)fd, 0, dispatch_get_main_queue());
+    dispatch_source_set_event_handler(g_read_src, ^{
+        if (atomic_load(&g_dsu_gen) != gen) return;
+        dsu_read_ready();
+    });
+    dispatch_source_set_cancel_handler(g_read_src, ^{
+        if (g_sock == fd) g_sock = -1;
+        close(fd);
+    });
+    dispatch_resume(g_read_src);
+
+    g_keepalive_timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, dispatch_get_main_queue());
+    dispatch_source_set_timer(g_keepalive_timer, DISPATCH_TIME_NOW, 1500 * NSEC_PER_MSEC, 100 * NSEC_PER_MSEC);
+    dispatch_source_set_event_handler(g_keepalive_timer, ^{
+        if (atomic_load(&g_dsu_gen) != gen) return;
+        dsu_send_subscribe();
+        dsu_check_timeouts();
+    });
+    dispatch_resume(g_keepalive_timer);
+
+    dsu_send_subscribe();
+    LOG("[dsu] Cemuhook UDP client active (target %s:%u, client id 0x%08x)", host, (unsigned)port, g_client_id);
+    return 1;
+}

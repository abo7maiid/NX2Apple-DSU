diff --git a/dm/host/tests/t_dsu.c b/dm/host/tests/t_dsu.c
new file mode 100644
index 0000000..8fda30d
--- /dev/null
+++ b/dm/host/tests/t_dsu.c
@@ -0,0 +1,105 @@
+// Cemuhook UDP (DSU Controller, dsu_proto.h) protocol framing, CRC32, button/stick decoding, and 6-axis motion conversion tests.
+#include <stdio.h>
+#include <stdlib.h>
+#include "../dsu_proto.h"
+
+static int checks, fails;
+#define CHECK(c) do { checks++; if (!(c)) { fails++; printf("FAIL %s:%d %s\n", __FILE__, __LINE__, #c); } } while (0)
+
+int main(void) {
+    // 1. IEEE 802.3 CRC32 standard vector ("123456789" -> 0xCBF43926)
+    const uint8_t vec[] = "123456789";
+    CHECK(dsu_crc32(vec, 9, 0) == 0xCBF43926u);
+
+    // 2. Client subscription request packet (0x100002) and controller info request (0x100001)
+    uint8_t req[32];
+    size_t n = dsu_make_data_req(req, 0x11223344u, 1, 2);
+    CHECK(n == 32);
+    CHECK(memcmp(req, "DSUC", 4) == 0 && dsu_u16(req + 4) == DSU_PROTOCOL_VERSION && dsu_u16(req + 6) == 16);
+    CHECK(dsu_u32(req + 12) == 0x11223344u && dsu_u32(req + 16) == DSU_MSG_DATA && req[20] == 1 && req[21] == 2);
+    uint32_t pkt_crc = dsu_u32(req + 8);
+    CHECK(dsu_crc32(req, n, 1) == pkt_crc);
+
+    size_t pn = dsu_make_ports_req(req, 0xAABBCCDDu);
+    CHECK(pn == 28 && dsu_u32(req + 16) == DSU_MSG_PORTS && dsu_u32(req + 20) == 4);
+
+    // 3. Server 0x100002 controller data packet parsing, buttons, sticks, and 6-axis motion
+    uint8_t pkt[100];
+    memset(pkt, 0, sizeof pkt);
+    memcpy(pkt, "DSUS", 4);
+    dsu_put_u16(pkt + 4, DSU_PROTOCOL_VERSION);
+    dsu_put_u16(pkt + 6, 84); // 100 - 16
+    dsu_put_u32(pkt + 12, 0xCAFEBABEu);
+    dsu_put_u32(pkt + 16, DSU_MSG_DATA);
+
+    pkt[20] = 0; // slot 0
+    pkt[21] = 2; // connected
+    pkt[22] = 2; // full gyro
+    pkt[23] = 2; // bluetooth
+    pkt[30] = 5; // battery full
+    pkt[31] = 1; // is_active
+    dsu_put_u32(pkt + 32, 42); // packet number
+    pkt[36] = 0x80 | 0x08 | 0x02; // D-pad Left (0x80), Start/+ (0x08), L3 (0x02)
+    pkt[37] = 0x20 | 0x40 | 0x02 | 0x04; // East/A (0x20), South/B (0x40), R2/ZR (0x02), L1/L (0x04)
+    pkt[38] = 0x01; // Home/PS
+    pkt[40] = 255;  // LX full right (+32767)
+    pkt[41] = 0;    // LY full down (-32767)
+    pkt[42] = 128;  // RX center (0)
+    pkt[43] = 255;  // RY full up (+32767)
+
+    // Motion timestamp: 1,500,000 us (offset 68)
+    dsu_put_u32(pkt + 68, 1500000u);
+    dsu_put_u32(pkt + 72, 0u);
+    // DSU accel: ax = 0, ay = -1.0 G (flat on table), az = 0
+    // DSU gyro: pitch = +90 deg/s, yaw = -180 deg/s, roll = +45 deg/s
+    float motion[6] = {0.0f, -1.0f, 0.0f, 90.0f, -180.0f, 45.0f};
+    for (int i = 0; i < 6; i++) {
+        uint32_t bits;
+        memcpy(&bits, &motion[i], 4);
+        dsu_put_u32(pkt + 76 + i * 4, bits);
+    }
+    dsu_put_u32(pkt + 8, dsu_crc32(pkt, sizeof pkt, 1));
+
+    dsu_report r;
+    CHECK(dsu_report_parse(pkt, sizeof pkt, &r));
+    CHECK(r.slot == 0 && r.connected == 1 && r.model == DSU_MODEL_FULL_GYRO && r.packet_num == 42);
+    CHECK(r.motion_ts_us == 1500000ull);
+
+    uint64_t btns = dsu_buttons(&r, 0);
+    CHECK((btns & DM_BTN_A) && (btns & DM_BTN_B) && !(btns & DM_BTN_X) && !(btns & DM_BTN_Y));
+    CHECK((btns & DM_BTN_LEFT) && (btns & DM_BTN_PLUS) && (btns & DM_BTN_LS) && (btns & DM_BTN_ZR) && (btns & DM_BTN_L));
+
+    int a = 0, b = 0;
+    dsu_ab(&r, &a, &b);
+    CHECK(a == 1 && b == 1 && dsu_home(&r) == 1);
+
+    int32_t st[4];
+    dsu_sticks(&r, st);
+    CHECK(st[0] == 32767 && st[1] == -32767 && st[2] == 0 && st[3] == 32767);
+
+    float acc[3], rot[3];
+    CHECK(dsu_motion_to_switch(&r, dsu_map_default, acc, rot));
+    // Default map {-1, -3, -2, 4, -6, 5}:
+    // acc = (-ax, -az, -ay) = (0, 0, +1.0)
+    // rot = (+pitch, -roll, +yaw) * pi/180 = (+pi/2, -pi/4, -pi)
+    CHECK(fabsf(acc[0]) < 1e-5f && fabsf(acc[1]) < 1e-5f && fabsf(acc[2] - 1.0f) < 1e-5f);
+    CHECK(fabsf(rot[0] - 1.5707963f) < 1e-4f && fabsf(rot[1] + 0.7853982f) < 1e-4f && fabsf(rot[2] + 3.1415927f) < 1e-4f);
+
+    // 4. Corrupted CRC32 is rejected
+    pkt[40] ^= 0x01;
+    CHECK(!dsu_report_parse(pkt, sizeof pkt, &r));
+
+    // 5. Custom DM_DSU_MAP parsing and clock sample pacing
+    int8_t custom_map[6];
+    CHECK(dsu_map_parse("-1,-3,-2,4,-6,5", custom_map) && memcmp(custom_map, dsu_map_default, 6) == 0);
+    CHECK(!dsu_map_parse("1,2,3,4,5,5", custom_map) && !dsu_map_parse("1,2,3", custom_map));
+
+    dsu_clock clk = {0};
+    uint64_t t0 = 1000000000ull;
+    CHECK(dsu_clock_sample(&clk, 1000, t0) == t0);
+    CHECK(dsu_clock_sample(&clk, 5000, t0 + 4000000ull) == t0 + 4000000ull);
+
+    if (fails) { printf("FAILED %d/%d checks\n", fails, checks); return 1; }
+    printf("t_dsu: %d checks passed\n", checks);
+    return 0;
+}

diff --git a/dm/host/dsu_proto.h b/dm/host/dsu_proto.h
new file mode 100644
index 0000000..4d79a15
--- /dev/null
+++ b/dm/host/dsu_proto.h
@@ -0,0 +1,325 @@
+// Cemuhook UDP (DSU Controller, protocol v1001, default port 26760) protocol parser, CRC32, and Switch coordinate mapping.
+// Pure C, no platform headers, so tests/t_dsu.c checks it on any machine; pad_dsu_apple.m is the UDP socket transport shared by
+// the Mac and iOS front ends (DmGamepad.m, controllers_mac.m).
+//
+// Specification: Cemuhook UDP Pad Motion Server protocol (version 1001, magic "DSUC" from client, "DSUS" from server, little-endian).
+// Message 0x100001 requests controller port info; Message 0x100002 requests/delivers controller data (buttons, analog sticks,
+// 2-point touch, microsecond motion timestamp, accelerometer in G, and gyroscope pitch/yaw/roll in deg/s).
+//
+// Coordinate frame conversion to Switch SixAxisSensorState / dm_motion_set_hid (G, rad/s, Switch frame: x right, y forward,
+// z up, gravity (0, 0, -1) lying flat face up):
+//   Cemuhook DSU defines:
+//     accel X: rightward acceleration (+X right)
+//     accel Y: upward/vertical acceleration (-1 G when lying flat face up in standard DSU servers)
+//     accel Z: forward/backward acceleration
+//     gyro Pitch: nose up/down (rotation around +X right, deg/s)
+//     gyro Yaw: turn left/right (rotation around vertical axis, deg/s)
+//     gyro Roll: tilt left/right (rotation around forward/backward axis, deg/s)
+//   Default mapping to Switch (x right, y forward, z up; right-handed rotations):
+//     Switch acc  = ( +dsu_acc_x, -dsu_acc_z, +dsu_acc_y )
+//     Switch gyro = ( +dsu_pitch, -dsu_roll,  -dsu_yaw   ) * (pi / 180)
+//   DM_DSU_MAP=a,b,c,d,e,f (six signed numbers in 1..6, like DM_SW2_MAP) overrides the 6-channel mapping if a particular DSU server
+//   uses different axes.
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+#include "dm_input.h"
+
+#define DSU_DEFAULT_PORT 26760
+#define DSU_PROTOCOL_VERSION 1001
+#define DSU_SLOTS 4
+
+#define DSU_MSG_VERSION 0x00100000u
+#define DSU_MSG_PORTS   0x00100001u
+#define DSU_MSG_DATA    0x00100002u
+
+enum {
+    DSU_STATE_DISCONNECTED = 0,
+    DSU_STATE_RESERVED     = 1,
+    DSU_STATE_CONNECTED    = 2,
+};
+
+enum {
+    DSU_MODEL_NONE      = 0,
+    DSU_MODEL_NO_GYRO   = 1,
+    DSU_MODEL_FULL_GYRO = 2,
+    DSU_MODEL_GENERIC   = 3,
+};
+
+enum {
+    DSU_CONN_NONE = 0,
+    DSU_CONN_USB  = 1,
+    DSU_CONN_BT   = 2,
+};
+
+// Bitmask 1 (offset 36)
+enum {
+    DSU_B1_SHARE   = 0x01,
+    DSU_B1_L3      = 0x02,
+    DSU_B1_R3      = 0x04,
+    DSU_B1_OPTIONS = 0x08,
+    DSU_B1_UP      = 0x10,
+    DSU_B1_RIGHT   = 0x20,
+    DSU_B1_DOWN    = 0x40,
+    DSU_B1_LEFT    = 0x80,
+};
+
+// Bitmask 2 (offset 37)
+enum {
+    DSU_B2_L2    = 0x01,
+    DSU_B2_R2    = 0x02,
+    DSU_B2_L1    = 0x04,
+    DSU_B2_R1    = 0x08,
+    DSU_B2_NORTH = 0x10,   // Triangle / X
+    DSU_B2_EAST  = 0x20,   // Circle / A
+    DSU_B2_SOUTH = 0x40,   // Cross / B
+    DSU_B2_WEST  = 0x80,   // Square / Y
+};
+
+static inline uint16_t dsu_u16(const uint8_t *p) { return (uint16_t)(p[0] | (uint16_t)p[1] << 8); }
+static inline uint32_t dsu_u32(const uint8_t *p) { return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24; }
+static inline uint64_t dsu_u64(const uint8_t *p) { return (uint64_t)dsu_u32(p) | (uint64_t)dsu_u32(p + 4) << 32; }
+static inline float dsu_f32(const uint8_t *p) { uint32_t u = dsu_u32(p); float f; memcpy(&f, &u, sizeof f); return f; }
+
+static inline void dsu_put_u16(uint8_t *p, uint16_t v) { p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); }
+static inline void dsu_put_u32(uint8_t *p, uint32_t v) { p[0] = (uint8_t)v; p[1] = (uint8_t)(v >> 8); p[2] = (uint8_t)(v >> 16); p[3] = (uint8_t)(v >> 24); }
+
+// Standard IEEE 802.3 CRC-32 over buf[0..len-1], treating bytes [8..11] (the CRC field itself) as zero when zero_crc_field is non-zero.
+static inline uint32_t dsu_crc32(const uint8_t *buf, size_t len, int zero_crc_field) {
+    uint32_t crc = 0xFFFFFFFFu;
+    for (size_t i = 0; i < len; i++) {
+        uint8_t b = (zero_crc_field && i >= 8 && i < 12) ? 0 : buf[i];
+        crc ^= b;
+        for (int k = 0; k < 8; k++) crc = (crc & 1) ? (0xEDB88320u ^ (crc >> 1)) : (crc >> 1);
+    }
+    return ~crc;
+}
+
+// Build a 32-byte DSUC 0x100002 controller data request packet.
+// reg_flags: 0 = subscribe to all controllers, 1 = slot-based (slot 0..3).
+static inline size_t dsu_make_data_req(uint8_t out[32], uint32_t client_id, uint8_t reg_flags, uint8_t slot) {
+    memset(out, 0, 32);
+    out[0] = 'D'; out[1] = 'S'; out[2] = 'U'; out[3] = 'C';
+    dsu_put_u16(out + 4, DSU_PROTOCOL_VERSION);
+    dsu_put_u16(out + 6, 16);   // payload length after the 16-byte header
+    dsu_put_u32(out + 12, client_id);
+    dsu_put_u32(out + 16, DSU_MSG_DATA);
+    out[20] = reg_flags;
+    out[21] = slot & 3;
+    uint32_t crc = dsu_crc32(out, 32, 1);
+    dsu_put_u32(out + 8, crc);
+    return 32;
+}
+
+// Build a 28-byte DSUC 0x100001 port info request for all 4 slots.
+static inline size_t dsu_make_ports_req(uint8_t out[28], uint32_t client_id) {
+    memset(out, 0, 28);
+    out[0] = 'D'; out[1] = 'S'; out[2] = 'U'; out[3] = 'C';
+    dsu_put_u16(out + 4, DSU_PROTOCOL_VERSION);
+    dsu_put_u16(out + 6, 12);
+    dsu_put_u32(out + 12, client_id);
+    dsu_put_u32(out + 16, DSU_MSG_PORTS);
+    dsu_put_u32(out + 20, 4);
+    out[24] = 0; out[25] = 1; out[26] = 2; out[27] = 3;
+    uint32_t crc = dsu_crc32(out, 28, 1);
+    dsu_put_u32(out + 8, crc);
+    return 28;
+}
+
+typedef struct {
+    int active;
+    uint16_t id;
+    uint16_t x, y;
+} dsu_touch_point;
+
+typedef struct {
+    uint8_t slot;
+    uint8_t state;
+    uint8_t model;
+    uint8_t conn;
+    uint8_t mac[6];
+    uint8_t battery;
+    uint8_t connected;
+    uint32_t packet_num;
+    uint8_t b1, b2, home, touch_btn;
+    uint8_t lx, ly, rx, ry;
+    uint8_t analog_dpad[4];     // left, down, right, up
+    uint8_t analog_face[4];     // E (A/Circle), S (B/Cross), N (X/Triangle), W (Y/Square)
+    uint8_t r1, l1, r2, l2;
+    dsu_touch_point touch[2];
+    uint64_t motion_ts_us;
+    float raw_motion[6];        // acc_x, acc_y, acc_z (G), pitch, yaw, roll (deg/s)
+} dsu_report;
+
+// Validate and parse a 100-byte DSUS 0x100002 controller data packet.
+// Returns 1 on valid controller data report, 0 otherwise.
+static inline int dsu_report_parse(const uint8_t *d, size_t len, dsu_report *r) {
+    if (r) memset(r, 0, sizeof *r);
+    if (!d || !r || len < 100) return 0;
+    if (d[0] != 'D' || d[1] != 'S' || d[2] != 'U' || d[3] != 'S') return 0;
+    if (dsu_u16(d + 4) != DSU_PROTOCOL_VERSION) return 0;
+    uint16_t plen = dsu_u16(d + 6);
+    if ((size_t)plen + 16 > len || plen < 84) return 0;
+    uint32_t got_crc = dsu_u32(d + 8);
+    if (dsu_crc32(d, (size_t)plen + 16, 1) != got_crc) return 0;
+    if (dsu_u32(d + 16) != DSU_MSG_DATA) return 0;
+    if (d[20] >= DSU_SLOTS) return 0;
+
+    r->slot = d[20];
+    r->state = d[21];
+    r->model = d[22];
+    r->conn = d[23];
+    memcpy(r->mac, d + 24, 6);
+    r->battery = d[30];
+    r->connected = (r->state == DSU_STATE_CONNECTED && d[31] != 0) ? 1 : 0;
+    r->packet_num = dsu_u32(d + 32);
+    r->b1 = d[36];
+    r->b2 = d[37];
+    r->home = d[38];
+    r->touch_btn = d[39];
+    r->lx = d[40]; r->ly = d[41]; r->rx = d[42]; r->ry = d[43];
+    for (int i = 0; i < 4; i++) r->analog_dpad[i] = d[44 + i];
+    r->r1 = d[48]; r->l1 = d[49]; r->r2 = d[50]; r->l2 = d[51];
+    for (int i = 0; i < 4; i++) r->analog_face[i] = d[52 + i];
+    for (int t = 0; t < 2; t++) {
+        const uint8_t *tp = d + 56 + t * 6;
+        r->touch[t].active = tp[0] != 0;
+        r->touch[t].id = tp[1];
+        r->touch[t].x = dsu_u16(tp + 2);
+        r->touch[t].y = dsu_u16(tp + 4);
+    }
+    r->motion_ts_us = dsu_u64(d + 68);
+    for (int i = 0; i < 6; i++) r->raw_motion[i] = dsu_f32(d + 76 + i * 4);
+    return 1;
+}
+
+// Convert DSU buttons and analog triggers into nn::hid NpadButton bits (DM_BTN_*).
+// If swap_ab != 0, East/South and North/West are swapped (Xbox/PlayStation label mapping instead of Switch positional mapping).
+static inline uint64_t dsu_buttons(const dsu_report *r, int swap_ab) {
+    if (!r || !r->connected) return 0;
+    uint64_t m = 0;
+    int east  = (r->b2 & DSU_B2_EAST)  || r->analog_face[0] > 128;
+    int south = (r->b2 & DSU_B2_SOUTH) || r->analog_face[1] > 128;
+    int north = (r->b2 & DSU_B2_NORTH) || r->analog_face[2] > 128;
+    int west  = (r->b2 & DSU_B2_WEST)  || r->analog_face[3] > 128;
+
+    if (swap_ab) {
+        if (south) m |= DM_BTN_A;
+        if (east)  m |= DM_BTN_B;
+        if (west)  m |= DM_BTN_X;
+        if (north) m |= DM_BTN_Y;
+    } else {
+        if (east)  m |= DM_BTN_A;
+        if (south) m |= DM_BTN_B;
+        if (north) m |= DM_BTN_X;
+        if (west)  m |= DM_BTN_Y;
+    }
+
+    if ((r->b2 & DSU_B2_L1) || r->l1 > 128) m |= DM_BTN_L;
+    if ((r->b2 & DSU_B2_R1) || r->r1 > 128) m |= DM_BTN_R;
+    if ((r->b2 & DSU_B2_L2) || r->l2 > 64)  m |= DM_BTN_ZL;
+    if ((r->b2 & DSU_B2_R2) || r->r2 > 64)  m |= DM_BTN_ZR;
+
+    if (r->b1 & DSU_B1_OPTIONS) m |= DM_BTN_PLUS;
+    if (r->b1 & DSU_B1_SHARE)   m |= DM_BTN_MINUS;
+    if (r->b1 & DSU_B1_L3)      m |= DM_BTN_LS;
+    if (r->b1 & DSU_B1_R3)      m |= DM_BTN_RS;
+
+    if ((r->b1 & DSU_B1_LEFT)  || r->analog_dpad[0] > 128) m |= DM_BTN_LEFT;
+    if ((r->b1 & DSU_B1_DOWN)  || r->analog_dpad[1] > 128) m |= DM_BTN_DOWN;
+    if ((r->b1 & DSU_B1_RIGHT) || r->analog_dpad[2] > 128) m |= DM_BTN_RIGHT;
+    if ((r->b1 & DSU_B1_UP)    || r->analog_dpad[3] > 128) m |= DM_BTN_UP;
+
+    return m;
+}
+
+static inline int32_t dsu_stick_axis(uint8_t raw) {
+    if (raw == 128) return 0;
+    float v = raw > 128 ? (float)(raw - 128) / 127.f : (float)((int)raw - 128) / 128.f;
+    if (v > 1.f) v = 1.f;
+    if (v < -1.f) v = -1.f;
+    return (int32_t)lrintf(v * DM_STICK_MAX);
+}
+
+static inline void dsu_sticks(const dsu_report *r, int32_t out[4]) {
+    if (!r || !r->connected) { out[0] = out[1] = out[2] = out[3] = 0; return; }
+    out[0] = dsu_stick_axis(r->lx);
+    out[1] = dsu_stick_axis(r->ly);
+    out[2] = dsu_stick_axis(r->rx);
+    out[3] = dsu_stick_axis(r->ry);
+}
+
+static inline int dsu_home(const dsu_report *r) {
+    return r && r->connected && ((r->home & 0x01) != 0 || (r->b1 & (DSU_B1_SHARE | DSU_B1_OPTIONS)) == (DSU_B1_SHARE | DSU_B1_OPTIONS));
+}
+
+static inline void dsu_ab(const dsu_report *r, int *a, int *b) {
+    if (!r || !r->connected) return;
+    if ((r->b2 & DSU_B2_EAST)  || r->analog_face[0] > 128) *a |= 1;
+    if ((r->b2 & DSU_B2_SOUTH) || r->analog_face[1] > 128) *b |= 1;
+}
+
+// Default 6-channel signed map from DSU raw_motion[0..5] (1:acc_x, 2:acc_y, 3:acc_z, 4:pitch, 5:yaw, 6:roll)
+// to Switch frame (acc x right, y forward, z up; gyro x pitch, y roll, z yaw).
+static const int8_t dsu_map_default[6] = {1, -3, 2, 4, -6, -5};
+#define DSU_DEG_TO_RAD (3.14159265358979323846f / 180.f)
+
+static inline int dsu_map_parse(const char *s, int8_t map[6]) {
+    int8_t m[6]; if (!s) return 0;
+    for (int i = 0; i < 6; i++) {
+        char *e; long v = strtol(s, &e, 10); if (e == s || v == 0 || v < -6 || v > 6) return 0;
+        m[i] = (int8_t)v; s = e; if (i < 5) { if (*s != ',') return 0; s++; }
+    }
+    if (*s) return 0;
+    memcpy(map, m, 6);
+    return 1;
+}
+
+// Convert DSU raw motion into Switch acceleration (G) and angular velocity (rad/s).
+// Returns 1 when the report carries finite, non-zero motion samples, 0 otherwise.
+static inline int dsu_motion_to_switch(const dsu_report *r, const int8_t map[6], float acc[3], float rot[3]) {
+    if (!r || !r->connected || r->model == DSU_MODEL_NO_GYRO) return 0;
+    int any = 0;
+    for (int i = 0; i < 6; i++) {
+        if (!isfinite(r->raw_motion[i])) return 0;
+        if (r->raw_motion[i] != 0.f) any = 1;
+    }
+    if (!any) return 0;
+    const int8_t *m = map ? map : dsu_map_default;
+    for (int i = 0; i < 6; i++) {
+        int c = m[i] < 0 ? -m[i] : m[i];
+        float sign = m[i] < 0 ? -1.f : 1.f;
+        if (c < 1 || c > 6) { c = 1; sign = 0.f; }
+        float v = sign * r->raw_motion[c - 1];
+        if (i < 3) acc[i] = v;
+        else rot[i - 3] = v * DSU_DEG_TO_RAD;
+    }
+    return 1;
+}
+
+// Track DSU microsecond timestamps and anchor them to host now_ns() for dm_motion_set_hid.
+typedef struct {
+    int have;
+    uint64_t last_us;
+    uint64_t host_ns;
+} dsu_clock;
+
+static inline uint64_t dsu_clock_sample(dsu_clock *c, uint64_t ts_us, uint64_t arrival_ns) {
+    if (!ts_us || !c->have || ts_us <= c->last_us || ts_us - c->last_us > 500000ull) {
+        c->have = 1;
+        c->last_us = ts_us;
+        c->host_ns = arrival_ns;
+        return arrival_ns;
+    }
+    uint64_t step_ns = (ts_us - c->last_us) * 1000ull;
+    uint64_t t = c->host_ns + step_ns;
+    if (t > arrival_ns) t = arrival_ns;
+    if (arrival_ns - t > 60000000ull) t = arrival_ns - 60000000ull;
+    if (t <= c->host_ns) t = c->host_ns + 1000ull;
+    c->last_us = ts_us;
+    c->host_ns = t;
+    return t;
+}
